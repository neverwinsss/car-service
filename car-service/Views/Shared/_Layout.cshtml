@inject SiteCache Cache
@{
    var s = await Cache.GetSettingsAsync();
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    string Active(string c) => string.Equals(controller, c, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    var isStaff = User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Manager);
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0e0f10" />
    <meta name="description" content="@(ViewData["Description"] ?? s.Slogan)" />
    <title>@(ViewData["Title"] is string t ? t + " — " : "")@s.CompanyName</title>
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="header">
        <div class="container header-inner">
            <a class="logo" asp-controller="Home" asp-action="Index">
                <span class="logo-mark">@Icons.Svg("wrench", 18)</span>
                <span class="logo-text">@s.CompanyName</span>
            </a>

            <button class="nav-toggle" type="button" aria-label="Меню" aria-expanded="false" data-nav-toggle>
                @Icons.Svg("menu", 22)
            </button>

            <nav class="nav" data-nav>
                <a class="@Active("About")" asp-controller="About" asp-action="Index">О сервисе</a>
                <a class="@Active("Services")" asp-controller="Services" asp-action="Index">Услуги</a>
                <a class="@Active("Booking")" asp-controller="Booking" asp-action="Index">Запись на обслуживание</a>
                <a class="@Active("Reviews")" asp-controller="Reviews" asp-action="Index">Отзывы</a>
                <a class="@Active("Contacts")" asp-controller="Contacts" asp-action="Index">Контакты</a>
                <a class="nav-account @Active("Account")" asp-controller="Account" asp-action="Index">
                    @Icons.Svg("user", 16) @(User.Identity?.IsAuthenticated == true ? "Личный кабинет" : "Войти")
                </a>
                @if (isStaff)
                {
                    <a class="nav-admin" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Админ-панель</a>
                }
            </nav>

            <div class="header-call">
                <a class="header-phone" href="@s.CallPhoneHref">@s.Phone</a>
                @if (s.CallButtonEnabled)
                {
                    <a class="btn btn-accent btn-call" href="@s.CallPhoneHref">@Icons.Svg("phone", 16) <span>@s.CallButtonText</span></a>
                }
            </div>
        </div>
    </header>

    <main>
        <partial name="_Flash" />
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="container footer-grid">
            <div>
                <a class="logo" asp-controller="Home" asp-action="Index">
                    <span class="logo-mark">@Icons.Svg("wrench", 18)</span>
                    <span class="logo-text">@s.CompanyName</span>
                </a>
                <p class="muted small mt-1">@s.Slogan</p>
                <div class="socials">
                    @if (!string.IsNullOrEmpty(s.VkUrl)) { <a href="@s.VkUrl" target="_blank" rel="noopener" aria-label="ВКонтакте">@Icons.Svg("vk")</a> }
                    @if (!string.IsNullOrEmpty(s.TelegramUrl)) { <a href="@s.TelegramUrl" target="_blank" rel="noopener" aria-label="Telegram">@Icons.Svg("telegram")</a> }
                    @if (!string.IsNullOrEmpty(s.WhatsappUrl)) { <a href="@s.WhatsappUrl" target="_blank" rel="noopener" aria-label="Мессенджер">@Icons.Svg("whatsapp")</a> }
                </div>
            </div>
            <div>
                <h4>Разделы</h4>
                <ul class="footer-links">
                    <li><a asp-controller="About" asp-action="Index">О сервисе</a></li>
                    <li><a asp-controller="Services" asp-action="Index">Услуги и цены</a></li>
                    <li><a asp-controller="Booking" asp-action="Index">Онлайн-запись</a></li>
                    <li><a asp-controller="Reviews" asp-action="Index">Отзывы</a></li>
                    <li><a asp-controller="Contacts" asp-action="Index">Контакты</a></li>
                    <li><a asp-controller="Account" asp-action="Index">Личный кабинет</a></li>
                </ul>
            </div>
            <div>
                <h4>Контакты</h4>
                <ul class="footer-links">
                    <li><a href="@s.CallPhoneHref">@s.Phone</a></li>
                    @if (!string.IsNullOrEmpty(s.Email)) { <li><a href="mailto:@s.Email">@s.Email</a></li> }
                    <li class="muted">@s.Address</li>
                    <li class="muted">@s.WorkHoursText</li>
                </ul>
            </div>
            <div>
                <h4>Информация</h4>
                <p class="muted small">@s.LegalInfo</p>
                <p class="muted small"><strong>Разработчики.</strong> @s.DevelopersInfo</p>
            </div>
        </div>
        <div class="container footer-bottom">
            <span>© @AppTime.Today.Year @s.CompanyName</span>
            <span>Сделано на ASP.NET Core + SQLite</span>
        </div>
    </footer>

    @if (s.CallButtonEnabled && s.CallButtonFloating)
    {
        <a class="call-float" href="@s.CallPhoneHref" aria-label="@s.CallButtonText">@Icons.Svg("phone", 24)</a>
    }

    <script src="~/js/site.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
