@{
    var code = ViewData["Code"] as int? ?? 0;
    ViewData["Title"] = code == 404 ? "Страница не найдена" : "Ошибка";
}
<section class="container page narrow center">
    <div class="big-code">@code</div>
    <h1>@(code == 404 ? "Страница не найдена" : code == 403 ? "Доступ запрещён" : "Что-то пошло не так")</h1>
    <p class="muted">@(code == 404 ? "Возможно, страница была удалена или вы ошиблись в адресе." : "Попробуйте вернуться на главную страницу.")</p>
    <a class="btn btn-accent" asp-controller="Home" asp-action="Index">На главную</a>
</section>
