@model TeamMember
@{ ViewData["Title"] = Model.Id == 0 ? "Новый сотрудник" : "Редактирование сотрудника"; }

<form method="post" class="card stack narrow-form">
    <input type="hidden" asp-for="Id" />
    <div class="form-grid">
        <div class="field">
            <label asp-for="Name"></label>
            <input asp-for="Name" required />
            <span asp-validation-for="Name" class="field-error"></span>
        </div>
        <div class="field">
            <label asp-for="Position"></label>
            <input asp-for="Position" required />
            <span asp-validation-for="Position" class="field-error"></span>
        </div>
        <div class="field">
            <label asp-for="Experience"></label>
            <input asp-for="Experience" type="number" min="0" max="70" />
        </div>
        <div class="field">
            <label asp-for="SortOrder"></label>
            <input asp-for="SortOrder" type="number" />
        </div>
    </div>
    <div class="field">
        <label asp-for="Description"></label>
        <textarea asp-for="Description" rows="3"></textarea>
    </div>
    <div class="row-between">
        <button class="btn btn-accent" type="submit">Сохранить</button>
        <a class="btn btn-ghost" asp-action="Index">Отмена</a>
    </div>
</form>
