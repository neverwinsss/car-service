@model List<Slide>
@{ ViewData["Title"] = "Баннер на главной"; }
@section Actions { <a class="btn btn-accent" asp-action="Edit">+ Добавить слайд</a> }

<div class="stack">
    @foreach (var s in Model)
    {
        <div class="card slide-admin @(s.IsActive ? "" : "dim")">
            <div>
                <div class="muted small">#@s.SortOrder @(s.IsActive ? "" : "· отключён") @(string.IsNullOrEmpty(s.Tag) ? "" : "· " + s.Tag)</div>
                <h3>@s.Title</h3>
                <p class="muted">@s.Subtitle</p>
                @if (!string.IsNullOrEmpty(s.ButtonText)) { <span class="badge">@s.ButtonText → @s.ButtonUrl</span> }
            </div>
            <div class="actions">
                <a class="btn btn-sm btn-outline" asp-action="Edit" asp-route-id="@s.Id">Изменить</a>
                <form method="post" asp-action="Delete" asp-route-id="@s.Id" onsubmit="return confirm('Удалить слайд?')"><button class="btn btn-sm btn-danger">Удалить</button></form>
            </div>
        </div>
    }
    @if (Model.Count == 0) { <p class="muted">Слайдов нет — баннер на главной будет пустым.</p> }
</div>
