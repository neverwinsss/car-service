@model List<ServiceItem>
@{ ViewData["Title"] = "Услуги"; }
@section Actions { <a class="btn btn-accent" asp-action="Edit">+ Добавить услугу</a> }

<div class="card">
    <div class="table-wrap">
        <table class="table">
            <thead><tr><th>#</th><th>Услуга</th><th>Цена от</th><th>Длит.</th><th>Статус</th><th class="right">Действия</th></tr></thead>
            <tbody>
                @foreach (var s in Model)
                {
                    <tr class="@(s.IsActive ? "" : "dim")">
                        <td data-label="#">@s.SortOrder</td>
                        <td data-label="Услуга"><span class="inline-icon">@Icons.Svg(s.Icon, 18)</span> <strong>@s.Title</strong><div class="muted small">@s.ShortDescription</div></td>
                        <td data-label="Цена">@s.PriceFrom.ToString("N0") ₽</td>
                        <td data-label="Длит.">@s.DurationMinutes мин</td>
                        <td data-label="Статус">
                            <span class="badge @(s.IsActive ? "badge-ok" : "badge-done")">@(s.IsActive ? "На сайте" : "Скрыта")</span>
                            @if (s.IsFeatured) { <span class="badge badge-info">На главной</span> }
                        </td>
                        <td class="right actions">
                            <a class="btn btn-sm btn-outline" asp-action="Edit" asp-route-id="@s.Id">Изменить</a>
                            <form method="post" asp-action="Delete" asp-route-id="@s.Id" onsubmit="return confirm('Удалить услугу?')"><button class="btn btn-sm btn-danger">Удалить</button></form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
